{
  "name": "cdpagentx",
  "version": "1.0.0",
  "private": true,
  "description": "Vendor-neutral simulator: rule-based CDP journeys vs. AI decisioning agents, measured against a holdout.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.3.2",
    "autoprefixer": "^10.4.14",
    "gh-pages": "^5.0.0",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.3.3",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
